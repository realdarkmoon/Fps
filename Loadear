-- Create Compact DARK MOON HUB Window
local Window = WindUI:CreateWindow({
	Title = "DARK MOON HUB",
	Icon = "moon",
	Author = "biyxznd",
	Folder = "DarkMoonHub",
	Size = UDim2.fromOffset(430, 265),
	Theme = "Dark",
	Transparent = true,
	SideBarWidth = 135,
	HasOutline = true,
})

local isExecuting = false

local function runScript(name, url)
	if isExecuting then
		return
	end
	isExecuting = true

	local copied = copyDiscordInvite()

	WindUI:Notify({
		Title = "DARK MOON HUB",
		Content = copied and ("Discord copied! Executing " .. name .. "...") or ("Executing " .. name .. "..."),
		Duration = 3,
		Icon = copied and "check" or "loader",
	})

	local ok, err = pcall(function()
		local raw = game:HttpGet(url)
		local fn = loadstring(raw)
		assert(type(fn) == "function", "Failed to compile " .. name)
		return fn()
	end)

	if ok then
		task.wait(0.3)
		pcall(function()
			Window:Destroy()
		end)
	else
		isExecuting = false
		WindUI:Notify({
			Title = "Execution Error",
			Content = "Failed to run " .. name .. " (check console F9).",
			Duration = 4,
			Icon = "alert-triangle",
		})
		warn("[DARK MOON HUB] Error in " .. name .. ": " .. tostring(err))
	end
end

